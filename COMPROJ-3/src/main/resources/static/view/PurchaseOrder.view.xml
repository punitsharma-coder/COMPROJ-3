<mvc:View xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    controllerName="punit.controller.PurchaseOrder">

    <Page title="Purchase Order Management System" showHeader="true" enableScrolling="true">

        <!-- ═══════════════════════════════════════════ -->
        <!--           OPERATION SELECTION               -->
        <!-- ═══════════════════════════════════════════ -->
        <Panel expandable="false" headerText="Select Operation"
            class="sapUiLargeMargin sapUiResponsiveMargin"
            visible="{/showOperationSelector}">
            <Toolbar class="sapUiSmallMargin">
                <Button text="Back" type="Default" press="onBackOpScreen" icon="sap-icon://nav-back"/>
            </Toolbar>
            <VBox alignItems="Center" class="sapUiMediumMargin">
                <HBox justifyContent="Center" class="sapUiSmallMargin">
                    <Button text="Create"
                        type="Accept"
                        press="onSelectCreate"
                        icon="sap-icon://add"
                        width="150px"
                        class="sapUiSmallMargin"/>
                    <Button text="Read"
                        type="Emphasized"
                        press="onSelectRead"
                        icon="sap-icon://search"
                        width="150px"
                        class="sapUiSmallMargin"/>
                    <Button text="Update"
                        type="Information"
                        press="onSelectUpdate"
                        icon="sap-icon://edit"
                        width="150px"
                        class="sapUiSmallMargin"/>
                </HBox>
            </VBox>
        </Panel>

        <!-- ═══════════════════════════════════════════ -->
        <!--                CREATE SECTION               -->
        <!-- ═══════════════════════════════════════════ -->
        <Panel expandable="false" headerText="Create New Purchase Order"
            class="sapUiLargeMargin sapUiResponsiveMargin"
            visible="{/showCreatePanel}">

            <Toolbar class="sapUiSmallMargin">
                <Button text="Back" type="Default" press="onBack" icon="sap-icon://nav-back"/>
            </Toolbar>

            <f:SimpleForm id="createCombinedForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                adjustLabelSpan="false"
                columnsXL="2" columnsL="1" columnsM="1"
                singleContainerFullSize="false">
                <f:content>
                    <core:Title text="PO Header" />

                    <Label text="Order Date *" />
                    <DatePicker id="createOrderDate"
                        value="{/createPayload/orderDate}"
                        displayFormat="yyyy-MM-dd"
                        valueFormat="yyyy-MM-dd"
                        placeholder="Select order date"
                        required="true"/>

                    <Label text="Delivery Date" />
                    <DatePicker id="createDeliveryDate"
                        value="{/createPayload/deliveryDate}"
                        displayFormat="yyyy-MM-dd"
                        valueFormat="yyyy-MM-dd"
                        placeholder="Select delivery date"/>

                    <Label text="Vendor ID *" />
                    <HBox>
                        <Input id="createVendorId"
                            value="{/createPayload/vendor/vendorId}"
                            placeholder="Enter Vendor ID"
                            required="true"
                            width="200px"/>
                        <Button icon="sap-icon://value-help"
                            press="onVendorF4Help"
                            tooltip="Click to select vendor (F4)"
                            width="auto"
                            class="sapUiSmallMarginBegin"/>
                    </HBox>
                </f:content>
            </f:SimpleForm>

            <!-- PO Items — 3 rows by default, no Add Row button -->
            <Panel expandable="false" headerText="Purchase Order Items" class="sapUiSmallMargin">
                <t:Table id="createItemsTable"
                    rows="{/createPayload/items}"
                    selectionMode="None"
                    visibleRowCount="3"
                    rowHeight="48"
                    class="sapUiSmallMargin">
                    <t:columns>
                        <t:Column width="40%">
                            <Label text="Material"/>
                            <t:template>
                                <HBox alignItems="Center">
                                    <Input value="{material}"
                                        placeholder="Select material"
                                        editable="false"
                                        width="100%"/>
                                    <Button icon="sap-icon://value-help"
                                        press="onMaterialF4Help"
                                        tooltip="Click to select material (F4)"
                                        width="auto"/>
                                </HBox>
                            </t:template>
                        </t:Column>
                        <t:Column width="160px">
                            <Label text="Quantity"/>
                            <t:template>
                                <Input value="{quantity}" type="Number" placeholder="Enter quantity"/>
                            </t:template>
                        </t:Column>
                        <t:Column width="160px">
                            <Label text="UOM"/>
                            <t:template>
                                <Input value="{uom}" placeholder="Auto-filled"/>
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>

            <Toolbar class="sapUiSmallMargin">
                <Button text="Save" type="Accept" press="onSaveCombined" icon="sap-icon://save"/>
            </Toolbar>
        </Panel>

        <!-- ═══════════════════════════════════════════ -->
        <!--                READ SECTION                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Panel expandable="false" headerText="View All Purchase Orders"
            class="sapUiLargeMargin sapUiResponsiveMargin"
            visible="{/showReadPanel}">

            <Toolbar class="sapUiSmallMargin">
                <Button text="Back" type="Default" press="onBack" icon="sap-icon://nav-back"/>
            </Toolbar>

            <!-- PO Number search with F4 help -->
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout"
                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                adjustLabelSpan="false" columnsXL="2" columnsL="1" columnsM="1"
                singleContainerFullSize="false">
                <f:content>
                    <Label text="PO Number" />
                    
                       <HBox>
						    <Input value="{/readSearchPoNumber}"
						        placeholder="Enter PO Number or use F4"
						        type="Number"
						        width="200px"/>
						    <Button icon="sap-icon://value-help"
						        press="onReadPoNumberF4Help"
						        tooltip="F4 Help"
						        class="sapUiSmallMarginBegin"/>
						    <Button text="Search"
						        type="Emphasized"
						        press="onReadSearchByPoNumber"
						        icon="sap-icon://search"
						        class="sapUiSmallMarginBegin"/>
						</HBox>
                </f:content>
            </f:SimpleForm>

            <!-- PO Header Table — hidden until Search is clicked -->
            <Panel expandable="false" headerText="PO Header"
                class="sapUiSmallMargin"
                visible="{/showReadResult}">
                <t:Table id="idHeaderTable"
                    selectionMode="None"
                    visibleRowCount="5"
                    class="sapUiSmallMargin">
                    <t:columns>
                        <t:Column width="120px">
                            <Label text="PO ID"/>
                            <t:template><Text text="{poId}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Order Date"/>
                            <t:template><Text text="{orderDate}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Delivery Date"/>
                            <t:template><Text text="{deliveryDate}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Vendor ID"/>
                            <t:template><Text text="{vendor/vendorId}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Vendor Name"/>
                            <t:template><Text text="{vendor/name}"/></t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>

            <!-- PO Items Table — only visible when a specific PO number is searched -->
            <Panel expandable="false" headerText="PO Items"
                class="sapUiSmallMargin"
                visible="{/showItemsTable}">
                <t:Table id="idItemTable"
                    selectionMode="None"
                    visibleRowCount="1"
                    class="sapUiSmallMargin">
                    <t:columns>
                        <t:Column width="100px">
                            <Label text="Item ID"/>
                            <t:template><Text text="{poItemId}"/></t:template>
                        </t:Column>
                        <t:Column width="120px">
                            <Label text="PO ID"/>
                            <t:template><Text text="{purchaseOrder/poId}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Material"/>
                            <t:template><Text text="{material}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Quantity"/>
                            <t:template><Text text="{quantity}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="UOM"/>
                            <t:template><Text text="{uom}"/></t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>
        </Panel>

        <!-- ═══════════════════════════════════════════ -->
        <!--               UPDATE SECTION                -->
        <!-- ═══════════════════════════════════════════ -->
        <Panel expandable="false" headerText="Update Purchase Order"
            class="sapUiLargeMargin sapUiResponsiveMargin"
            visible="{/showUpdatePanel}">

            <Toolbar class="sapUiSmallMargin">
                <Button text="Back" type="Default" press="onBack" icon="sap-icon://nav-back"/>
            </Toolbar>

            <!-- PO Number search with F4 help -->
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout"
                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                adjustLabelSpan="false" columnsXL="2" columnsL="1" columnsM="1"
                singleContainerFullSize="false">
                <f:content>
                    <Label text="PO Number *" />
                    <HBox>
                        <Input id="updateSearchPoId"
                            value="{/searchPoNumber}"
                            placeholder="Enter PO Number or use F4"
                            type="Number"
                            width="200px"
                            required="true"/>
                        <Button icon="sap-icon://value-help"
                            press="onUpdatePoNumberF4Help"
                            tooltip="Click to select PO Number (F4)"
                            width="auto"
                            class="sapUiSmallMarginBegin"/>
                        <Button text="Search &amp; Load"
                            type="Emphasized"
                            press="onSearchByPoNumber"
                            icon="sap-icon://search"
                            class="sapUiSmallMarginBegin"/>
                    </HBox>
                </f:content>
            </f:SimpleForm>

            <!-- Result Panel — shows only after successful search -->
            <Panel expandable="false" visible="{/showPoSearchResult}"
                headerText="Edit Purchase Order"
                class="sapUiLargeMargin sapUiResponsiveMargin">

                <!-- Header table with editable fields + F4 for vendor -->
                <Panel expandable="false" headerText="PO Header" class="sapUiSmallMargin">
                    <t:Table id="updatePoHeaderTable"
                        rows="{/filteredPoHeader}"
                        selectionMode="None"
                        visibleRowCount="1"
                        rowHeight="52"
                        class="sapUiSmallMargin">
                        <t:columns>
                            <t:Column width="100px">
                                <Label text="PO Number"/>
                                <t:template>
                                    <Text text="{poId}"/>
                                </t:template>
                            </t:Column>
                            <t:Column width="200px">
                                <Label text="Order Date"/>
                                <t:template>
                                    <DatePicker value="{orderDate}"
                                        displayFormat="dd-MM-yyyy"
                                        valueFormat="yyyy-MM-dd"
                                        width="100%"/>
                                </t:template>
                            </t:Column>
                            <t:Column width="200px">
                                <Label text="Delivery Date"/>
                                <t:template>
                                    <DatePicker value="{deliveryDate}"
                                        displayFormat="dd-MM-yyyy"
                                        valueFormat="yyyy-MM-dd"
                                        width="100%"/>
                                </t:template>
                            </t:Column>
                            <t:Column width="250px">
                                <Label text="Vendor Name"/>
                                <t:template>
                                    <HBox alignItems="Center">
                                        <Input value="{vendor/name}"
                                            placeholder="Vendor name"
                                            editable="false"
                                            width="190px"/>
                                        <Button icon="sap-icon://value-help"
                                            press="onUpdateVendorF4Help"
                                            tooltip="Click to select vendor (F4)"
                                            width="auto"/>
                                    </HBox>
                                </t:template>
                            </t:Column>
                        </t:columns>
                    </t:Table>
                </Panel>

                <!-- Items edit table — only quantity is editable -->
                <Panel expandable="false" headerText="PO Items" class="sapUiSmallMargin">
                    <t:Table id="updatePoItemsTable"
                        rows="{/filteredPoItems}"
                        selectionMode="None"
                        visibleRowCount="1"
                        rowHeight="52"
                        class="sapUiSmallMargin">
                        <t:columns>
                            <t:Column width="100px">
                                <Label text="Item ID"/>
                                <t:template><Text text="{poItemId}"/></t:template>
                            </t:Column>
                            <t:Column width="300px">
                                <Label text="Material"/>
                                <t:template><Text text="{material}"/></t:template>
                            </t:Column>
                            <t:Column width="200px">
                                <Label text="Quantity"/>
                                <t:template>
                                    <Input value="{quantity}" type="Number"
                                        placeholder="Enter quantity"
                                        width="100%"/>
                                </t:template>
                            </t:Column>
                            <t:Column width="120px">
                                <Label text="UOM"/>
                                <t:template><Text text="{uom}"/></t:template>
                            </t:Column>
                        </t:columns>
                    </t:Table>
                </Panel>

                <Toolbar class="sapUiSmallMargin">
                    <Button text="Update" type="Accept" press="onUpdateItem" icon="sap-icon://save"/>
                    <Button text="Cancel" type="Reject" press="onCancelItemEdit" icon="sap-icon://cancel"/>
                </Toolbar>

            </Panel>
        </Panel>

    </Page>
</mvc:View>