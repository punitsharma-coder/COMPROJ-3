<mvc:View xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    controllerName="punit.controller.PurchaseOrder">

    <Page title="Purchase Order Management System" showHeader="true" enableScrolling="true">

        <!-- OPERATION SELECTION BUTTONS -->
        <Panel expandable="false" headerText="Select Operation"
            class="sapUiLargeMargin sapUiResponsiveMargin"
            visible="{/showOperationSelector}">
            <VBox alignItems="Center" class="sapUiMediumMargin">
                <HBox justifyContent="Center" class="sapUiSmallMargin">
                    <Button text="Create"
                        type="Accept"
                        press="onSelectCreate"
                        icon="sap-icon://add"
                        width="150px"
                        class="sapUiSmallMargin"/>
                    <Button text="Read"
                        type="Emphasized"
                        press="onSelectRead"
                        icon="sap-icon://search"
                        width="150px"
                        class="sapUiSmallMargin"/>
                    <!-- ✅ FIX: type="Information" is not valid — changed to Default -->
                    <Button text="Update"
                        type="Default"
                        press="onSelectUpdate"
                        icon="sap-icon://edit"
                        width="150px"
                        class="sapUiSmallMargin"/>
                </HBox>
            </VBox>
        </Panel>

        <!-- ═══════════════════════════════════════════ -->
        <!--              CREATE SECTION                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Panel expandable="false" headerText="Create New Purchase Order"
            class="sapUiLargeMargin sapUiResponsiveMargin"
            visible="{/showCreatePanel}">

            <f:SimpleForm id="createCombinedForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                columnsXL="2"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false">
                <f:content>

                    <core:Title text="PO Header" />

                    <Label text="PO Number (optional)" />
                    <Input id="createPoNumber"
                    value="{/createPayload/poId}"
                    placeholder="Leave blank to auto-generate"
                    type="Number"/>
                        
                    <Label text="Order Date *" />
                    <DatePicker id="createOrderDate"
                        value="{/createPayload/orderDate}"
                        displayFormat="yyyy-MM-dd"
                        valueFormat="yyyy-MM-dd"
                        placeholder="Select order date"
                        required="true"/>

                    <Label text="Delivery Date" />
                    <DatePicker id="createDeliveryDate"
                        value="{/createPayload/deliveryDate}"
                        displayFormat="yyyy-MM-dd"
                        valueFormat="yyyy-MM-dd"
                        placeholder="Select delivery date"/>

                    <Label text="Vendor ID *" />
                    <HBox>
                        <Input id="createVendorId"
                            value="{/createPayload/vendor/vendorId}"
                            placeholder="Enter Vendor ID"
                            required="true"
                            width="200px"/>
                        <!-- ✅ F4 Help button for Vendor -->
                        <Button icon="sap-icon://value-help"
                            press="onVendorF4Help"
                            tooltip="Click to select vendor (F4)"
                            width="auto"
                            class="sapUiSmallMarginBegin"/>
                    </HBox>

                </f:content>
            </f:SimpleForm>

            <!-- PO Items Table -->
            <Panel expandable="false" headerText="Purchase Order Items"
                class="sapUiSmallMargin">

                <t:Table id="createItemsTable"
                    rows="{/createPayload/items}"
                    selectionMode="None"
                    visibleRowCount="1"
                    rowHeight="48"
                    class="sapUiSmallMargin">

                    <t:columns>

                        <t:Column width="33%">
                            <Label text="Material"/>
                            <t:template>
                                <!-- ✅ Material F4 Help — read-only input + value-help button -->
                                <HBox alignItems="Center">
                                    <Input value="{material}"
                                        placeholder="Select material"
                                        editable="false"
                                        width="100%"/>
                                    <Button icon="sap-icon://value-help"
                                        press="onMaterialF4Help"
                                        tooltip="Click to select material (F4)"
                                        width="auto"
                                        class="sapUiSmallMarginBegin"/>
                                </HBox>
                            </t:template>
                        </t:Column>

                        <t:Column width="160px">
                            <Label text="Quantity"/>
                            <t:template>
                                <Input value="{quantity}"
                                    type="Number"
                                    placeholder="Enter quantity"/>
                            </t:template>
                        </t:Column>

                        <t:Column width="160px">
                            <Label text="UOM"/>
                            <t:template>
                                <Input value="{uom}"
                                    placeholder="Enter unit of measurement"/>
                            </t:template>
                        </t:Column>

                    </t:columns>

                </t:Table>

                <Toolbar class="sapUiSmallMargin">
                    <Button text="Add Row"
                        type="Emphasized"
                        press="onAddItem"
                        icon="sap-icon://add"/>
                </Toolbar>

            </Panel>

            <Toolbar class="sapUiSmallMargin">
                <Button text="Save" type="Accept" press="onSaveCombined"
                    icon="sap-icon://save"/>
                <Button text="Back" type="Default" press="onBack"
                    icon="sap-icon://nav-back"/>
            </Toolbar>

        </Panel>

        <!-- ═══════════════════════════════════════════ -->
        <!--               READ SECTION                  -->
        <!-- ═══════════════════════════════════════════ -->
        <Panel expandable="false" headerText="View All Purchase Orders"
            class="sapUiLargeMargin sapUiResponsiveMargin"
            visible="{/showReadPanel}">

            <Toolbar class="sapUiSmallMargin">
                <Button text="Load Data" type="Default" press="onLoadData"
                    icon="sap-icon://refresh"/>
                <Button text="Back" type="Default" press="onBack"
                    icon="sap-icon://nav-back"/>
            </Toolbar>

            <!-- PO Header Table -->
            <Panel expandable="false" headerText="PO Header"
                class="sapUiSmallMargin">
                <t:Table id="idHeaderTable"
                    selectionMode="None"
                    visibleRowCount="5"
                    class="sapUiSmallMargin">
                    <t:columns>
                        <t:Column width="120px">
                            <Label text="PO ID"/>
                            <t:template>
                                <Text text="{poId}"/>
                            </t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Order Date"/>
                            <t:template>
                                <Text text="{orderDate}"/>
                            </t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Delivery Date"/>
                            <t:template>
                                <Text text="{deliveryDate}"/>
                            </t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Vendor ID"/>
                            <t:template>
                                <Text text="{vendor/vendorId}"/>
                            </t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Vendor Name"/>
                            <t:template>
                                <Text text="{vendor/name}"/>
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>

            <!-- PO Items Table -->
            <Panel expandable="false" headerText="PO Items"
                class="sapUiSmallMargin">
                <t:Table id="idItemTable"
                    selectionMode="None"
                    visibleRowCount="5"
                    class="sapUiSmallMargin">
                    <t:columns>
                        <t:Column width="100px">
                            <Label text="Item No"/>
                            <t:template>
                                <!-- ✅ FIX: was {itemNumber} — correct field name is {itemNo} -->
                                <Text text="{poItemId}"/>
                            </t:template>
                        </t:Column>
                        <t:Column width="120px">
                            <Label text="PO ID"/>
                            <t:template>
                                <!-- ✅ FIX: was {purchaseOrderHeader/poNumber} — correct path is {purchaseOrder/poId} -->
                                <Text text="{purchaseOrder/poId}"/>
                            </t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Material"/>
                            <t:template>
                                <Text text="{material}"/>
                            </t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Quantity"/>
                            <t:template>
                                <Text text="{quantity}"/>
                            </t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="UOM"/>
                            <t:template>
                                <Text text="{uom}"/>
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>

        </Panel>

        <!-- ═══════════════════════════════════════════ -->
        <!--              UPDATE SECTION                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Panel expandable="false" headerText="Update PO Item"
            class="sapUiLargeMargin sapUiResponsiveMargin"
            visible="{/showUpdatePanel}">

            <f:SimpleForm id="updateSearchForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                columnsXL="2"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false">
                <f:content>
                    <Label text="Enter Item ID *" />
                    <Input id="searchItemId"
                        value="{/searchItemId}"
                        placeholder="Enter PO Item ID to search"
                        required="true"/>
                </f:content>
            </f:SimpleForm>

            <Toolbar class="sapUiSmallMargin">
                <Button text="Search &amp; Load" type="Emphasized"
                    press="onSearchItem" icon="sap-icon://search"/>
                <Button text="Back" type="Default" press="onBack"
                    icon="sap-icon://nav-back"/>
            </Toolbar>

            <!-- Edit Panel — shown after search -->
            <Panel expandable="false" visible="{/editItemMode}"
                headerText="Edit PO Item"
                class="sapUiLargeMargin sapUiResponsiveMargin">

                <f:SimpleForm id="editItemForm"
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="3"
                    labelSpanL="3"
                    labelSpanM="4"
                    labelSpanS="12"
                    adjustLabelSpan="false"
                    columnsXL="2"
                    columnsL="1"
                    columnsM="1"
                    singleContainerFullSize="false">
                    <f:content>
                        <Label text="Item ID" />
                        <Text text="{/editItemPayload/poItemId}" />
                        <Label text="PO ID" />
                        <Text text="{/editItemPayload/purchaseOrder/poId}" />
                        <Label text="Material" />
                        <Text text="{/editItemPayload/material}" />
                        <Label text="Quantity *" />
                        <Input id="editItemQuantity"
                            value="{/editItemPayload/quantity}"
                            placeholder="Enter new quantity"
                            type="Number"
                            required="true"/>
                        <Label text="UOM" />
                        <Text text="{/editItemPayload/uom}" />
                    </f:content>
                </f:SimpleForm>

                <Toolbar class="sapUiSmallMargin">
                    <Button text="Update" type="Accept" press="onUpdateItem"
                        icon="sap-icon://save"/>
                    <Button text="Cancel" type="Reject" press="onCancelItemEdit"
                        icon="sap-icon://cancel"/>
                </Toolbar>

            </Panel>

        </Panel>

    </Page>
</mvc:View>