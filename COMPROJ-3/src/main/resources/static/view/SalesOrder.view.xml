<mvc:View xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    controllerName="punit.controller.SalesOrder">

    <Page title="Sales Order Management System" showHeader="true" enableScrolling="true">

        <!-- ═══════════════════════════════════════════ -->
        <!--           OPERATION SELECTION               -->
        <!-- ═══════════════════════════════════════════ -->
        <Panel expandable="false" headerText="Select Operation"
            class="sapUiLargeMargin sapUiResponsiveMargin"
            visible="{/showOperationSelector}">
            
            <Toolbar class="sapUiSmallMargin">
                <Button text="Back" type="Default" press="onBackOpScreen" icon="sap-icon://nav-back"/>
            </Toolbar>
            <VBox alignItems="Center" class="sapUiMediumMargin">
                <HBox justifyContent="Center" class="sapUiSmallMargin">
                    <Button text="Create"
                        type="Accept"
                        press="onSelectCreate"
                        icon="sap-icon://add"
                        width="150px"
                        class="sapUiSmallMargin"/>
                    <Button text="Read"
                        type="Emphasized"
                        press="onSelectRead"
                        icon="sap-icon://search"
                        width="150px"
                        class="sapUiSmallMargin"/>
                    <Button text="Update"
                        type="Information"
                        press="onSelectUpdate"
                        icon="sap-icon://edit"
                        width="150px"
                        class="sapUiSmallMargin"/>
                </HBox>
            </VBox>
        </Panel>

        <!-- ═══════════════════════════════════════════ -->
        <!--                CREATE SECTION               -->
        <!-- ═══════════════════════════════════════════ -->
        <Panel expandable="false" headerText="Create New Sales Order"
            class="sapUiLargeMargin sapUiResponsiveMargin"
            visible="{/showCreatePanel}">
            
            <Toolbar class="sapUiSmallMargin">
                <Button text="Back" type="Default" press="onBack" icon="sap-icon://nav-back"/>
            </Toolbar>
            <f:SimpleForm id="createCombinedForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                adjustLabelSpan="false"
                columnsXL="2" columnsL="1" columnsM="1"
                singleContainerFullSize="false">
                <f:content>
                    <core:Title text="Sales Order Header" />

                    <Label text="SO Number (optional)" />
                    <Input id="createSoNumber"
                        value="{/createPayload/salesOrderNumber}"
                        placeholder="Leave blank to auto-generate"
                        type="Number"/>

                    <Label text="Order Date *" />
                    <DatePicker id="createOrderDate"
                        value="{/createPayload/dateOfOrder}"
                        displayFormat="yyyy-MM-dd"
                        valueFormat="yyyy-MM-dd"
                        placeholder="Select order date"
                        required="true"/>

                    <Label text="Delivery Date" />
                    <DatePicker id="createDeliveryDate"
                        value="{/createPayload/dateOfDelivery}"
                        displayFormat="yyyy-MM-dd"
                        valueFormat="yyyy-MM-dd"
                        placeholder="Select delivery date"/>

                    <Label text="Customer ID *" />
                    <HBox>
                        <Input id="createCustomerId"
                            value="{/createPayload/customer/customerId}"
                            placeholder="Enter customer ID"
                            required="true"
                            width="200px"/>
                        <Button icon="sap-icon://value-help"
                            press="onCustomerF4Help"
                            tooltip="Click to select customer (F4)"
                            width="auto"
                            class="sapUiSmallMarginBegin"/>
                    </HBox>
                </f:content>
            </f:SimpleForm>

            <!-- Items table — 3 rows by default, no Add Row button -->
            <Panel expandable="false" headerText="Sales Order Items" class="sapUiSmallMargin">
                <t:Table id="createItemsTable"
                    rows="{/createPayload/items}"
                    selectionMode="None"
                    visibleRowCount="3"
                    rowHeight="48"
                    class="sapUiSmallMargin">
                    <t:columns>
                        <t:Column width="40%">
                            <Label text="Material"/>
                            <t:template>
                                <HBox alignItems="Center">
                                    <Input value="{material}"
                                        placeholder="Select material"
                                        editable="false"
                                        width="100%"/>
                                    <Button icon="sap-icon://value-help"
                                        press="onMaterialF4Help"
                                        tooltip="Click to select material (F4)"
                                        width="auto"/>
                                </HBox>
                            </t:template>
                        </t:Column>
                        <t:Column width="160px">
                            <Label text="Quantity"/>
                            <t:template>
                                <Input value="{quantity}" type="Number" placeholder="Enter quantity"/>
                            </t:template>
                        </t:Column>
                        <t:Column width="160px">
                            <Label text="UOM"/>
                            <t:template>
                                <Input value="{uom}" placeholder="Auto-filled"/>
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>

            <Toolbar class="sapUiSmallMargin">
                <Button text="Save" type="Accept" press="onSaveCombined" icon="sap-icon://save"/>
                <!--<Button text="Back" type="Default" press="onBack" icon="sap-icon://nav-back"/>-->
            </Toolbar>

        </Panel>

        <!-- ═══════════════════════════════════════════ -->
        <!--                READ SECTION                 -->
        <!-- ═══════════════════════════════════════════ -->
        <!--<Toolbar class="sapUiSmallMargin">
                <Button text="Back" type="Default" press="onBack" icon="sap-icon://nav-back"/>
        </Toolbar>-->
        <Panel expandable="false" headerText="View All Sales Orders"
            class="sapUiLargeMargin sapUiResponsiveMargin"
            visible="{/showReadPanel}">

            <Toolbar class="sapUiSmallMargin">
                <Button text="Back" type="Default" press="onBack" icon="sap-icon://nav-back"/>
            </Toolbar>
            <!-- SO Number search with F4 help -->
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout"
                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                adjustLabelSpan="false" columnsXL="2" columnsL="1" columnsM="1"
                singleContainerFullSize="false">
                <f:content>
                    <Label text="SO Number" />
                    <HBox>
                        <Input value="{/readSearchSoNumber}"
                            placeholder="Enter SO Number or use F4"
                            type="Number"
                            width="200px"/>
                        <Button icon="sap-icon://value-help"
                            press="onReadSoNumberF4Help"
                            tooltip="Click to select SO Number (F4)"
                            width="auto"
                            class="sapUiSmallMarginBegin"/>
                        <Button text="Search"
                            type="Emphasized"
                            press="onReadSearchBySoNumber"
                            icon="sap-icon://search"
                            class="sapUiSmallMarginBegin"/>
                    </HBox>
                </f:content>
            </f:SimpleForm>

            

            <!-- SO Header Table — hidden until Search is clicked -->
            <Panel expandable="false" headerText="Sales Order"
                class="sapUiSmallMargin"
                visible="{/showReadResult}">
                <t:Table id="idHeaderTable"
                    selectionMode="None"
                    visibleRowCount="5"
                    class="sapUiSmallMargin">
                    <t:columns>
                        <t:Column width="120px">
                            <Label text="Order No"/>
                            <t:template><Text text="{salesOrderNumber}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Order Date"/>
                            <t:template><Text text="{dateOfOrder}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Delivery Date"/>
                            <t:template><Text text="{dateOfDelivery}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Customer ID"/>
                            <t:template><Text text="{customer/customerId}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Customer Name"/>
                            <t:template><Text text="{customer/name}"/></t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>

            <!-- SO Items Table — only visible when a specific SO number is searched -->
            <Panel expandable="false" headerText="Items"
                class="sapUiSmallMargin"
                visible="{/showItemsTable}">
                <t:Table id="idItemTable"
                    selectionMode="None"
                    visibleRowCount="1"
                    class="sapUiSmallMargin">
                    <t:columns>
                        <t:Column width="100px">
                            <Label text="Item No"/>
                            <t:template><Text text="{itemNumber}"/></t:template>
                        </t:Column>
                        <t:Column width="120px">
                            <Label text="SO Number"/>
                            <t:template><Text text="{salesOrderHeader/salesOrderNumber}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Material"/>
                            <t:template><Text text="{material}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Quantity"/>
                            <t:template><Text text="{quantity}"/></t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="UOM"/>
                            <t:template><Text text="{uom}"/></t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>

        </Panel>

        <!-- ═══════════════════════════════════════════ -->
        <!--               UPDATE SECTION                -->
        <!-- ═══════════════════════════════════════════ -->
        <Panel expandable="false" headerText="Update Sales Order"
            class="sapUiLargeMargin sapUiResponsiveMargin"
            visible="{/showUpdatePanel}">

            <Toolbar class="sapUiSmallMargin">
                <Button text="Back" type="Default" press="onBack" icon="sap-icon://nav-back"/>
            </Toolbar>
            <!-- SO Number search with F4 help -->
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout"
                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                adjustLabelSpan="false" columnsXL="2" columnsL="1" columnsM="1"
                singleContainerFullSize="false">
                <f:content>
                    <Label text="SO Number *" />
                    <HBox>
                        <Input id="updateSearchSoId"
                            value="{/searchSoNumber}"
                            placeholder="Enter SO Number or use F4"
                            type="Number"
                            width="200px"
                            required="true"/>
                        <Button icon="sap-icon://value-help"
                            press="onUpdateSoNumberF4Help"
                            tooltip="Click to select SO Number (F4)"
                            width="auto"
                            class="sapUiSmallMarginBegin"/>
                        <Button text="Search &amp; Load"
                            type="Emphasized"
                            press="onSearchBySoNumber"
                            icon="sap-icon://search"
                            class="sapUiSmallMarginBegin"/>
                    </HBox>
                </f:content>
            </f:SimpleForm>

            <!-- Result Panel — shows only after successful search -->
            <Panel expandable="false" visible="{/showSoSearchResult}"
                headerText="Edit Sales Order"
                class="sapUiLargeMargin sapUiResponsiveMargin">

                <!-- Header table with editable fields + F4 for customer -->
                <Panel expandable="false" headerText="Sales Order" class="sapUiSmallMargin">
                    <t:Table id="updateHeaderTable"
                        rows="{/filteredSoHeader}"
                        selectionMode="None"
                        visibleRowCount="1"
                        rowHeight="52"
                        class="sapUiSmallMargin">
                        <t:columns>
                            <t:Column width="100px">
                                <Label text="SO Number"/>
                                <t:template>
                                    <Text text="{salesOrderNumber}"/>
                                </t:template>
                            </t:Column>
                            <t:Column width="200px">
                                <Label text="Order Date"/>
                                <t:template>
                                    <DatePicker value="{dateOfOrder}"
                                        displayFormat="dd-MM-yyyy"
                                        valueFormat="yyyy-MM-dd"
                                        width="100%"/>
                                </t:template>
                            </t:Column>
                            <t:Column width="200px">
                                <Label text="Delivery Date"/>
                                <t:template>
                                    <DatePicker value="{dateOfDelivery}"
                                        displayFormat="dd-MM-yyyy"
                                        valueFormat="yyyy-MM-dd"
                                        width="100%"/>
                                </t:template>
                            </t:Column>
                            <t:Column width="250px">
                                <Label text="Customer Name"/>
                                <t:template>
                                    <HBox alignItems="Center">
                                        <Input value="{customer/name}"
                                            placeholder="Customer name"
                                            editable="false"
                                            width="190px"/>
                                        <Button icon="sap-icon://value-help"
                                            press="onUpdateCustomerF4Help"
                                            tooltip="Click to select customer (F4)"
                                            width="auto"/>
                                    </HBox>
                                </t:template>
                            </t:Column>
                        </t:columns>
                    </t:Table>
                </Panel>

                <!-- Items edit table — only quantity is editable -->
                <Panel expandable="false" headerText="Items" class="sapUiSmallMargin">
                    <t:Table id="updateItemsTable"
                        rows="{/filteredSoItems}"
                        selectionMode="None"
                        visibleRowCount="1"
                        rowHeight="52"
                        class="sapUiSmallMargin">
                        <t:columns>
                            <t:Column width="100px">
                                <Label text="Item No"/>
                                <t:template><Text text="{itemNumber}"/></t:template>
                            </t:Column>
                            <t:Column width="300px">
                                <Label text="Material"/>
                                <t:template><Text text="{material}"/></t:template>
                            </t:Column>
                            <t:Column width="200px">
                                <Label text="Quantity"/>
                                <t:template>
                                    <Input value="{quantity}" type="Number"
                                        placeholder="Enter quantity"
                                        width="100%"/>
                                </t:template>
                            </t:Column>
                            <t:Column width="120px">
                                <Label text="UOM"/>
                                <t:template><Text text="{uom}"/></t:template>
                            </t:Column>
                        </t:columns>
                    </t:Table>
                </Panel>

                <Toolbar class="sapUiSmallMargin">
                    <Button text="Update" type="Accept" press="onUpdateItem" icon="sap-icon://save"/>
                    <Button text="Cancel" type="Reject" press="onCancelItemEdit" icon="sap-icon://cancel"/>
                </Toolbar>

            </Panel>
        </Panel>

    </Page>
</mvc:View>